<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0B0B0F">
<com.gathin.tvhome.SkyView android:id="@+id/sky" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no"/>
<View android:id="@+id/ambient" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"/>
<View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/home_scrim"/>
<TextView android:id="@+id/heroName" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
<LinearLayout android:id="@+id/heroPanel" android:layout_width="430dp" android:layout_height="wrap_content" android:layout_marginStart="43dp" android:layout_marginTop="136dp" android:orientation="vertical">
<TextView android:id="@+id/heroEyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#BFFFFFFF" android:textSize="15sp" android:fontFamily="@font/outfit_regular"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="62dp" android:layout_marginTop="5dp" android:orientation="horizontal" android:gravity="center_vertical">
<ImageView android:id="@+id/heroArtwork" android:visibility="gone" android:layout_width="48dp" android:layout_height="58dp" android:layout_marginEnd="14dp" android:scaleType="fitCenter" android:contentDescription="@null"/>
<TextView android:id="@+id/heroTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="45sp" android:fontFamily="@font/sf_display_bold" android:letterSpacing="-0.025" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
<TextView android:id="@+id/heroSubtitle" android:layout_width="340dp" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textColor="#C9FFFFFF" android:textSize="16sp" android:lineSpacingExtra="2dp" android:fontFamily="@font/outfit_regular" android:maxLines="2"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:visibility="gone" android:layout_marginTop="15dp" android:orientation="horizontal" android:clipChildren="false">
<Button android:id="@+id/heroPrimary" android:layout_width="wrap_content" android:layout_height="40dp" android:paddingHorizontal="24dp" android:background="@drawable/open_button" android:textColor="#111115" android:fontFamily="@font/sf_display_semibold" android:textSize="16sp" android:textAllCaps="false" android:minHeight="0dp" android:minWidth="164dp" android:drawableStart="@drawable/ic_open_play" android:drawablePadding="9dp" android:nextFocusUp="@id/tabHome" android:nextFocusDown="@id/grid"/>
<Button android:id="@+id/heroPlus" android:layout_width="42dp" android:layout_height="40dp" android:layout_marginStart="12dp" android:background="@drawable/header_glass" android:text="+" android:textSize="28sp" android:fontFamily="@font/outfit_light" android:textColor="@drawable/pill_text" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:contentDescription="Edit favorites" android:nextFocusDown="@id/grid"/>
</LinearLayout>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="32dp" android:paddingEnd="32dp" android:paddingTop="20dp" android:clipChildren="false" android:clipToPadding="false">
<RelativeLayout android:layout_width="match_parent" android:layout_height="40dp" android:clipChildren="false" android:clipToPadding="false">
<LinearLayout android:id="@+id/leftBlock" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone">
<TextView android:id="@+id/pageTitle" android:layout_width="0dp" android:layout_height="0dp"/>
<TextView android:id="@+id/greeting" android:layout_width="0dp" android:layout_height="0dp"/>
<TextView android:id="@+id/shamsiDate" android:layout_width="0dp" android:layout_height="0dp"/>
<TextClock android:id="@+id/date" android:layout_width="0dp" android:layout_height="0dp"/>
</LinearLayout>
<TextView android:id="@+id/stats" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
<LinearLayout android:id="@+id/navigationTabs" android:layout_width="wrap_content" android:layout_height="38dp" android:layout_centerInParent="true" android:orientation="horizontal" android:gravity="center" android:padding="1dp" android:background="@drawable/nav_capsule" android:clipChildren="false" android:clipToPadding="false">
<TextView android:id="@+id/tabHome" style="@style/NavigationTab" android:text="Home"/>
<TextView android:id="@+id/tabApps" style="@style/NavigationTab" android:text="Apps"/>
<TextView android:id="@+id/tabLibrary" style="@style/NavigationTab" android:text="Library" android:visibility="gone" android:focusable="false"/>
<TextView android:id="@+id/tabSearch" style="@style/NavigationTab" android:text="Search"/>
</LinearLayout>
<LinearLayout android:id="@+id/topButtons" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_alignParentEnd="true" android:orientation="horizontal" android:gravity="center_vertical" android:clipChildren="false">
<TextView android:id="@+id/btnSettings" style="@style/HeaderIcon" android:drawableStart="@drawable/ic_reference_gear" android:contentDescription="@string/settings"/>
<TextView android:id="@+id/btnWifi" style="@style/HeaderIcon" android:drawableStart="@drawable/ic_header_wifi" android:contentDescription="@string/wifi"/>
<TextView android:id="@+id/btnInputs" style="@style/HeaderIcon" android:drawableStart="@drawable/ic_reference_hdmi" android:contentDescription="@string/inputs"/>
<TextClock android:id="@+id/clock" android:layout_width="62dp" android:layout_height="34dp" android:layout_marginStart="12dp" android:background="@drawable/nav_capsule" android:gravity="center" android:format12Hour="HH:mm" android:format24Hour="HH:mm" android:textColor="#FAFFFFFF" android:textSize="16sp" android:fontFamily="@font/sf_display_medium"/>
<TextClock android:id="@+id/ampm" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
<Button android:id="@+id/btnReorder" style="@style/HeaderEdit" android:text="Edit" android:visibility="gone"/>
</LinearLayout>
</RelativeLayout>
<EditText android:id="@+id/appSearch" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="10dp" android:paddingHorizontal="20dp" android:background="@drawable/nav_capsule" android:textColor="#FFFFFF" android:textColorHint="#80FFFFFF" android:textSize="18sp" android:hint="Search your apps" android:singleLine="true" android:inputType="text" android:imeOptions="actionSearch" android:visibility="gone" android:nextFocusUp="@id/tabSearch" android:nextFocusDown="@id/grid"/>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:clipChildren="false">
<androidx.recyclerview.widget.RecyclerView android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingTop="10dp" android:paddingBottom="8dp" android:clipToPadding="false" android:clipChildren="false" android:overScrollMode="never" android:scrollbars="none" android:descendantFocusability="afterDescendants"/>
</FrameLayout>
</LinearLayout>
<com.gathin.tvhome.GlassView android:id="@+id/glass" android:layout_width="10dp" android:layout_height="10dp" android:alpha="0" android:importantForAccessibility="no"/>
</FrameLayout>
